{
  "name": "学术论文知识图谱",
  "description": "用于学术论文分析和引文网络构建的本体",
  "language": "zh",
  "entity_types": [
    "Author",
    "Paper",
    "Institution",
    "Conference",
    "Journal",
    "Dataset",
    "Method",
    "Task",
    "Metric",
    "Other"
  ],
  "relation_types": [
    "撰写",
    "引用",
    "使用",
    "属于",
    "提出",
    "评测",
    "发表于",
    "合作",
    "Other"
  ],
  "entity_attributes": {
    "Paper": {
      "title": {
        "type": "string",
        "required": true,
        "description": "论文标题"
      },
      "year": {
        "type": "number",
        "required": false,
        "description": "发表年份",
        "min_value": 1900,
        "max_value": 2100
      },
      "doi": {
        "type": "string",
        "required": false,
        "description": "DOI标识符"
      },
      "abstract": {
        "type": "string",
        "required": false,
        "description": "摘要"
      }
    },
    "Author": {
      "affiliation": {
        "type": "string",
        "required": false,
        "description": "所属机构"
      },
      "email": {
        "type": "string",
        "required": false,
        "description": "邮箱"
      },
      "orcid": {
        "type": "string",
        "required": false,
        "description": "ORCID标识符"
      }
    },
    "Dataset": {
      "size": {
        "type": "string",
        "required": false,
        "description": "数据集规模"
      },
      "domain": {
        "type": "string",
        "required": false,
        "description": "应用领域"
      },
      "url": {
        "type": "string",
        "required": false,
        "description": "下载地址"
      }
    },
    "Metric": {
      "value": {
        "type": "number",
        "required": false,
        "description": "指标值"
      },
      "unit": {
        "type": "string",
        "required": false,
        "description": "单位"
      }
    }
  },
  "relation_attributes": {
    "引用": {
      "context": {
        "type": "string",
        "required": false,
        "description": "引用上下文"
      },
      "citation_type": {
        "type": "string",
        "required": false,
        "description": "引用类型",
        "enum_values": ["背景", "方法", "对比", "扩展"]
      }
    },
    "评测": {
      "metric_name": {
        "type": "string",
        "required": false,
        "description": "评测指标名称"
      },
      "score": {
        "type": "string",
        "required": false,
        "description": "评测分数"
      }
    }
  },
  "normalization_rules": {
    "case_sensitive": false,
    "trim_whitespace": true
  }
}
