{
  "name": "文化遗产知识图谱本体",
  "description": "用于文化遗产领域的知识抽取本体规范，定义了核心实体类型和关系类型",
  "language": "zh",
  "entity_types": [
    "Person",
    "Organization",
    "Location",
    "Event",
    "Artifact",
    "Concept",
    "TimePeriod",
    "Other"
  ],
  "relation_types": [
    "创作",
    "属于",
    "位于",
    "发生于",
    "关联",
    "影响",
    "继承",
    "包含",
    "Other"
  ],
  "entity_attributes": {
    "Person": {
      "birth_date": {
        "type": "date",
        "required": false,
        "description": "出生日期"
      },
      "death_date": {
        "type": "date",
        "required": false,
        "description": "逝世日期"
      },
      "nationality": {
        "type": "string",
        "required": false,
        "description": "国籍"
      },
      "occupation": {
        "type": "string",
        "required": false,
        "description": "职业",
        "enum_values": ["艺术家", "政治家", "学者", "工匠", "其他"]
      }
    },
    "Artifact": {
      "creation_date": {
        "type": "date",
        "required": false,
        "description": "创作/制作日期"
      },
      "material": {
        "type": "string",
        "required": false,
        "description": "材质"
      },
      "dimensions": {
        "type": "string",
        "required": false,
        "description": "尺寸规格"
      },
      "current_location": {
        "type": "string",
        "required": false,
        "description": "现藏地点"
      }
    },
    "Location": {
      "coordinates": {
        "type": "string",
        "required": false,
        "description": "地理坐标"
      },
      "address": {
        "type": "string",
        "required": false,
        "description": "详细地址"
      }
    },
    "Event": {
      "start_date": {
        "type": "date",
        "required": false,
        "description": "开始日期"
      },
      "end_date": {
        "type": "date",
        "required": false,
        "description": "结束日期"
      },
      "significance": {
        "type": "string",
        "required": false,
        "description": "历史意义"
      }
    },
    "TimePeriod": {
      "start_year": {
        "type": "number",
        "required": false,
        "description": "起始年份",
        "min_value": -5000,
        "max_value": 2100
      },
      "end_year": {
        "type": "number",
        "required": false,
        "description": "结束年份",
        "min_value": -5000,
        "max_value": 2100
      },
      "dynasty": {
        "type": "string",
        "required": false,
        "description": "朝代/时代"
      }
    }
  },
  "relation_attributes": {
    "创作": {
      "role": {
        "type": "string",
        "required": false,
        "description": "创作角色",
        "enum_values": ["主创", "协作", "指导", "赞助"]
      }
    },
    "属于": {
      "membership_type": {
        "type": "string",
        "required": false,
        "description": "隶属类型",
        "enum_values": ["正式成员", "创始人", "荣誉成员"]
      }
    },
    "影响": {
      "influence_type": {
        "type": "string",
        "required": false,
        "description": "影响类型",
        "enum_values": ["直接影响", "间接影响", "风格继承"]
      },
      "influence_strength": {
        "type": "string",
        "required": false,
        "description": "影响程度",
        "enum_values": ["强", "中", "弱"]
      }
    }
  },
  "normalization_rules": {
    "case_sensitive": false,
    "trim_whitespace": true,
    "merge_similar_entities": true,
    "similarity_threshold": 0.85
  }
}
